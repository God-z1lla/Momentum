# Required in production
ROUTINE_TRACKER_ENV=production
ROUTINE_TRACKER_SECRET=generate-a-long-random-secret
ROUTINE_TRACKER_HTTPS=1
ROUTINE_TRACKER_TRUST_PROXY=0

# SQLite path is local by default; set an absolute path if needed
ROUTINE_TRACKER_DB=

# Password reset email via SMTP (optional until configured)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER=
SMTP_USE_TLS=1

# Stripe subscriptions (optional until configured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_YEARLY_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=

# Web Push (requires HTTPS outside localhost)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Optional application settings
FLASK_DEBUG=0

# Authentication defaults to one persistent local profile. Set to accounts for
# email/password registration, login, logout, password reset, and user isolation.
ROUTINE_TRACKER_AUTH=shared

# Legacy local launcher setting; run_local.py enables this automatically
ROUTINE_TRACKER_LOCAL=0
